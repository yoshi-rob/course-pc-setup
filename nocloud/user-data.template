#cloud-config
autoinstall:
  version: 1
  refresh-installer:
    update: false
  # Focal's unattended-upgrades otherwise fails on ubuntu-pro conffile prompts.
  apt:
    conf: |
      Dpkg::Options {
        "--force-confdef";
        "--force-confold";
      };
      Unattended-Upgrade::MinimalSteps "false";
  # Focal curtin temporarily removes apt.conf.d settings before upgrades.
  # Transient systemd services inherit this environment; /cdrom is also
  # mounted inside curtin's target until apt configuration is restored.
  early-commands:
    - systemctl set-environment APT_CONFIG=/cdrom/course-setup/installer-apt.conf
  interactive-sections:
    - network
    - storage
  locale: ja_JP.UTF-8
  keyboard:
    layout: jp
    variant: ""
  identity:
    hostname: course-pc
    username: student1
    realname: Student
    password: "@PASSWORD_HASH@"
  ssh:
    install-server: false
  packages:
    - curl
    - ca-certificates
  late-commands:
    - systemctl unset-environment APT_CONFIG
    - mkdir -p /target/opt/course-setup/keys
    - cp /cdrom/course-setup/coins_ws-src.tar.gz /cdrom/course-setup/course-workspace.sha256 /target/opt/course-setup/
    - cp /cdrom/course-setup/keys/ros-snapshot.asc /target/opt/course-setup/keys/ros-snapshot.asc
    - curtin in-target --target=/target -- curl -fL --retry 3 --connect-timeout 20 --max-time 180 @SETUP_URL@ -o /opt/course-setup/setup.sh
    - echo '@SETUP_SHA256@  /target/opt/course-setup/setup.sh' | sha256sum -c -
    - chmod 755 /target/opt/course-setup/setup.sh
    - curtin in-target --target=/target -- bash /opt/course-setup/setup.sh
  error-commands:
    - systemctl unset-environment APT_CONFIG
